# Expo public env for API base URL
# Use your LAN IP if testing on a real device, e.g. 192.168.1.100:5000
EXPO_PUBLIC_API_URL=http://192.168.8.103:5000

##You can get your own ip address and change the above URL accordingly
#to check it type ipconfig in the pc cmd/powershell and look for IPv4 Address 
